# ---------------------------------------------------------------------------
# Visitor analytics — environment variables
# Copy to .env.local and fill in. See docs/analytics-setup.md.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Injected automatically by the Vercel Neon integration when a database is
# connected to the project. Code falls back to POSTGRES_URL if unset.
# Pull locally with:  vercel env pull .env.local
DATABASE_URL=

# --- Secrets (required — generate your own, never commit real values) ------
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Password for /admin/login
ADMIN_PASSWORD=

# Signs admin session cookies and analytics session ids
SESSION_SECRET=

# Salts the per-visitor IP hash (rotating it resets visitor identity)
ANALYTICS_IP_HASH_SECRET=

# Authenticates the daily retention cron (/api/admin/retention).
# Vercel sets this automatically on paid plans; on Hobby, set it yourself.
CRON_SECRET=

# --- Optional --------------------------------------------------------------
# Store raw IPs instead of hashes. Anything other than the exact string
# "true" leaves this off. Leave unset unless you have a specific reason.
# ANALYTICS_STORE_RAW_IP=false

# Required only when ANALYTICS_STORE_RAW_IP=true
# ANALYTICS_IP_ENCRYPTION_KEY=

# Days of data to retain before the cron prunes it. Defaults to 400.
# ANALYTICS_RETENTION_DAYS=400

# Comma-separated IPs to exclude from tracking (e.g. your own).
# ANALYTICS_INTERNAL_IPS=
